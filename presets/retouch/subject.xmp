   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Brightens the people a little and opens their shadows, so they stand out from the scene.</rdf:li>
     <rdf:li xml:lang="de-DE">Hellt die Personen leicht auf und öffnet ihre Schatten, damit sie sich vom Umfeld abheben.</rdf:li>
    </rdf:Alt>
   </crs:Description>
