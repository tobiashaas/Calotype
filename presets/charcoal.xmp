   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Deep, dense black and white: rich blacks, dark skies, plenty of texture. Reportage, church, character portraits.</rdf:li>
     <rdf:li xml:lang="de-DE">Tiefes, dichtes Schwarz-Weiß: satte Schwarztöne, dunkler Himmel, viel Struktur. Reportage, Kirche, Charakterporträts.</rdf:li>
    </rdf:Alt>
   </crs:Description>
