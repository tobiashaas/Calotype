   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Bright, airy black and white: glowing skin, fine detail, gently lifted blacks. Bridal portraits, backlight, mist.</rdf:li>
     <rdf:li xml:lang="de-DE">Helles, luftiges Schwarz-Weiß: leuchtende Haut, feine Details, sanft angehobene Schwarztöne. Brautporträts, Gegenlicht, Nebel.</rdf:li>
    </rdf:Alt>
   </crs:Description>
