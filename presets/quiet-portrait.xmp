   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Timeless and calm: soft skin, gentle contrast, muted colors, a light vignette. Portraits, couples, families.</rdf:li>
     <rdf:li xml:lang="de-DE">Zeitlos und ruhig: weiche Haut, sanfter Kontrast, gedämpfte Farben, leichte Vignette. Porträts, Paarfotos, Familien.</rdf:li>
    </rdf:Alt>
   </crs:Description>
