   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wedding Emotional</rdf:li>
     <rdf:li xml:lang="de-DE">Wedding Emotional</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Calotype</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The maintainer's wedding look as 26 of his weddings 2020–2023 carry it: matte shadows through the channel curves, restrained reds and yellows, fine grain, a light vignette.</rdf:li>
     <rdf:li xml:lang="de-DE">Der Hochzeits-Look des Maintainers, wie ihn 26 seiner Hochzeiten 2020–2023 tragen: matte Tiefen über die Farbkurven, zurückgenommene Rot- und Gelbtöne, feines Korn, leichte Vignette.</rdf:li>
    </rdf:Alt>
   </crs:Description>
