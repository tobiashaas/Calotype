   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Classic wedding look: Texture +10, Clarity +10, Dehaze +20, tone settings, warm skin hues and signature tone curve.</rdf:li>
     <rdf:li xml:lang="de-DE">Klassischer Hochzeits-Look: Struktur +10, Klarheit +10, Dehaze +20, Tonwerte, edle Farbtöne und Gradationskurve.</rdf:li>
    </rdf:Alt>
