   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Gentle, low-contrast black and white with lifted blacks. Quiet moments, newborns.</rdf:li>
     <rdf:li xml:lang="de-DE">Sanftes Schwarz-Weiß mit wenig Kontrast und angehobenen Schwarztönen. Stille Momente, Neugeborene.</rdf:li>
    </rdf:Alt>
   </crs:Description>
