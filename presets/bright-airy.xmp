   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Light and open: lifted shadows, low contrast, pastel greens and blues. Weddings, lifestyle.</rdf:li>
     <rdf:li xml:lang="de-DE">Hell und offen: angehobene Schatten, wenig Kontrast, pastellige Grün- und Blautöne. Hochzeiten, Lifestyle.</rdf:li>
    </rdf:Alt>
   </crs:Description>
