   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm, soft glow in the highlights, gentle contrast, calm colors. Evening light, string lights, wedding parties.</rdf:li>
     <rdf:li xml:lang="de-DE">Warmes, weiches Leuchten in den Lichtern, sanfter Kontrast, ruhige Farben. Abendlicht, Lichterketten, Hochzeitsfeiern.</rdf:li>
    </rdf:Alt>
   </crs:Description>
