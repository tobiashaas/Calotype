   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm vintage: faded blacks, amber highlights, teal shadows, matte greens and grain. Reportage, travel, outdoor parties.</rdf:li>
     <rdf:li xml:lang="de-DE">Warmes Vintage: verblasste Schwarztöne, bernsteinfarbene Lichter, blaugrüne Schatten, mattes Grün und Korn. Reportage, Reisen, Feiern draußen.</rdf:li>
    </rdf:Alt>
