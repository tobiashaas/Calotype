   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm midtones and highlights, calm blue sky. Outdoor portraits, events at dusk.</rdf:li>
     <rdf:li xml:lang="de-DE">Warme Mitteltöne und Lichter, ruhiger blauer Himmel. Porträts draußen, Events in der Dämmerung.</rdf:li>
    </rdf:Alt>
   </crs:Description>
