   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Pastel Morning</rdf:li>
     <rdf:li xml:lang="de-DE">Pastellmorgen</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:SortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"></rdf:li>
    </rdf:Alt>
   </crs:SortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Calotype</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dreamy and bright: soft highlights, lifted blacks, a hint of peach and lilac, quiet greens. Getting ready, bridal portraits, babies.</rdf:li>
     <rdf:li xml:lang="de-DE">Verträumt und hell: weiche Lichter, angehobene Schwarztöne, zarte Pfirsich- und Fliedertöne, zurückgenommenes Grün. Getting Ready, Brautporträts, Babys.</rdf:li>
    </rdf:Alt>
   </crs:Description>
