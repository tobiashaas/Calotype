   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Warm &amp; Soft</rdf:li>
     <rdf:li xml:lang="de-DE">Warm &amp; Weich</rdf:li>
    </rdf:Alt>
   </crs:Name>
