   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Gentle, warm skin tones; slightly lifted blacks; quiet greens. Portraits, families.</rdf:li>
     <rdf:li xml:lang="de-DE">Sanfte, warme Hauttöne, leicht angehobene Schwarztöne, ruhiges Grün. Porträts, Familien.</rdf:li>
    </rdf:Alt>
   </crs:Description>
