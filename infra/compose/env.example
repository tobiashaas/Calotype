LR_FF_POSTGRES_PORT=5432
LR_FF_POSTGRES_DB=tarsier
LR_FF_POSTGRES_USER=tarsier
LR_FF_POSTGRES_PASSWORD=tarsier

LR_FF_REDIS_PORT=6379

LR_FF_MINIO_PORT=9000
LR_FF_MINIO_CONSOLE_PORT=9001
LR_FF_MINIO_USER=minio
LR_FF_MINIO_PASSWORD=miniosecret_changeme

# API / Worker (kopieren nach .env lokal — nicht commiten)
DATABASE_URL=postgresql+psycopg://tarsier:tarsier@127.0.0.1:5432/tarsier
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret_changeme
S3_BUCKET=lr-frameflow

# Use 127.0.0.1, not "localhost": on Windows, localhost tries IPv6 (::1) first and Docker's
# port forward accepts but never answers there — every connection then waits ~21 s.
